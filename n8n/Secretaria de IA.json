    {
      "parameters": {
        "jsCode": "const texto = $('AI Agent').first().json.output;\nconst bruto = texto.split('###LEAD###')[1];\n\nlet lead;\ntry {\n  lead = JSON.parse(bruto.trim());\n} catch (e) {\n  throw new Error('JSON da lead inválido: ' + bruto);\n}\n\nconst msg = $('Webhook').first().json.body.messages[0];\n\nreturn [{\n  json: {\n    telefone: msg.from,\n    nome_whatsapp: msg.from_name || msg.chat_name || '',\n    n8n_id: lead.n8n_id,\n    nome: lead.nome,\n    cpf: lead.cpf,\n    area: lead.area,\n    resumo: lead.resumo,\n    urgencia: lead.urgencia,\n    processo_andamento: lead.processo_andamento,\n    cidade_estado: lead.cidade_estado,\n    email: lead.email,\n    disponibilidade: lead.disponibilidade,\n    data_criacao: new Date().toISOString()\n  }\n}];"
      },
